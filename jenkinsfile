pipeline {
    agent any

    environment {
        S3_BUCKET = "petclinicapp-bucketmy"
        BUILD_FILE_NAME = "spring-boot-initial-0.0.1-SNAPSHOT.jar"
        LOCAL_FILE_PATH = "/home/petclinicapp/spring-boot-initial-0.0.1-SNAPSHOT.jar"
        SSH_KEY = "/home/jenkins/petclinicappkey.pem"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                echo "Cleaning previous builds"
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                echo "Checkout source code"
                git branch: 'main',
                    url: 'https://github.com/hinakeshar1234/gs-spring-boot.git'
            }
        }

        stage('Build') {
            steps {
                echo "Build Spring Boot app from initial folder"
                sh '''
                cd initial
                chmod +x mvnw
                ./mvnw clean package
                '''
            }
        }

        stage('Upload to S3') {
            steps {
                echo "Upload JAR to S3"
                sh '''
                aws s3 cp $WORKSPACE/initial/target/$BUILD_FILE_NAME s3://$S3_BUCKET/
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                script {
                    echo "Fetch running EC2 instances tagged with appname=petclinic"

                    def ips = sh(
                        script: '''
                        aws ec2 describe-instances \
                          --filters "Name=tag:appname,Values=petclinic" \
                                    "Name=instance-state-name,Values=running" \
                          --query "Reservations[*].Instances[*].PublicIpAddress" \
                          --output text
                        ''',
                        returnStdout: true
                    ).trim().split()

                    for (ip in ips) {
                        echo "Deploying to ${ip}"
                        sh """
                        ssh -o StrictHostKeyChecking=no -i ${SSH_KEY} ubuntu@${ip} << 'EOF'
                        mkdir -p /home/petclinicapp
                        aws s3 cp s3://${S3_BUCKET}/${BUILD_FILE_NAME} ${LOCAL_FILE_PATH}
                        if systemctl list-units --full -all | grep -q petclinicapp.service; then
                            sudo systemctl restart petclinicapp.service
                        else
                            echo "Service not found, creating a simple one"
                            echo -e "[Unit]\\nDescription=Pet Clinic App\\nAfter=network.target\\n\\n[Service]\\nUser=ubuntu\\nExecStart=/usr/bin/java -jar ${LOCAL_FILE_PATH}\\nSuccessExitStatus=143\\n\\n[Install]\\nWantedBy=multi-user.target" | sudo tee /etc/systemd/system/petclinicapp.service
                            sudo systemctl daemon-reload
                            sudo systemctl enable petclinicapp.service
                            sudo systemctl start petclinicapp.service
                        fi
                        EOF
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ BUILD & DEPLOYMENT SUCCESS"
        }
        failure {
            echo "❌ PIPELINE FAILED – check console output"
        }
    }
}
